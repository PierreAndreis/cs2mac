+/*
+ * Cocoa-side helpers for the GPTK D3DMetal compatibility table (gptk.c).
+ */
+
+#import <AppKit/AppKit.h>
+#import <QuartzCore/QuartzCore.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+#include "macdrv_cocoa.h"
+#include "cocoa_event.h"
+
+static int gptk_debug(void)
+{
+    static int debug = -1;
+    if (debug < 0) debug = getenv("CS2MAC_GPTK_DEBUG") != NULL;
+    return debug;
+}
+
+static void dump_layer(CALayer *layer, int depth)
+{
+    fprintf(stderr, "gptk: %*s layer %s %p frame=%s hidden=%d opacity=%.2f zpos=%.1f contents=%p bg=%p\n", depth * 2, "",
+            [[layer className] UTF8String], layer, [NSStringFromRect(NSRectFromCGRect(layer.frame)) UTF8String],
+            layer.isHidden, layer.opacity, layer.zPosition, layer.contents, layer.backgroundColor);
+    for (CALayer *sub in layer.sublayers) dump_layer(sub, depth + 1);
+}
+
+static void dump_view(NSView *view, int depth)
+{
+    fprintf(stderr, "gptk: %*s view %s %p frame=%s hidden=%d wantsLayer=%d layer=%p alpha=%.2f\n", depth * 2, "",
+            [[view className] UTF8String], view, [NSStringFromRect(view.frame) UTF8String], view.isHidden,
+            view.wantsLayer, view.layer, view.alphaValue);
+    for (NSView *sub in view.subviews) dump_view(sub, depth + 1);
+}
+
+/* Dump the view / layer state D3DMetal is about to render into. */
+void macdrv_gptk_dump_metal_view(macdrv_metal_view v)
+{
+    NSView *view = (NSView *)v;
+    __block NSString *desc;
+
+    if (!gptk_debug()) return;
+    OnMainThread(^{
+        CALayer *layer = view.layer;
+        desc = [[NSString stringWithFormat:@"view=%@ frame=%@ hidden=%d window=%p onscreen=%d superview=%@ superframe=%@ superhidden=%d layer=%@ bounds=%@ scale=%.1f drawable=%@",
+                 [view className], NSStringFromRect(view.frame), view.isHiddenOrHasHiddenAncestor, view.window, view.window.isVisible,
+                 [view.superview className], NSStringFromRect(view.superview.frame), view.superview.isHidden,
+                 [layer className], NSStringFromRect(NSRectFromCGRect(layer.bounds)), layer.contentsScale,
+                 [layer isKindOfClass:[CAMetalLayer class]] ? NSStringFromSize(NSSizeFromCGSize(((CAMetalLayer *)layer).drawableSize)) : @"n/a"] retain];
+    });
+    fprintf(stderr, "gptk: %s\n", [desc UTF8String]);
+    [desc release];
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 25 * NSEC_PER_SEC), dispatch_get_main_queue(), ^{
+        NSWindow *window = view.window;
+        fprintf(stderr, "gptk: window %p visible=%d alpha=%.2f opaque=%d level=%ld frame=%s occlusion=%lu childWindows=%lu\n", window, window.isVisible,
+                window.alphaValue, window.isOpaque, (long)window.level, [NSStringFromRect(window.frame) UTF8String],
+                (unsigned long)window.occlusionState, (unsigned long)window.childWindows.count);
+        dump_view(window.contentView, 1);
+        dump_layer(window.contentView.layer, 1);
+        if ([view.layer isKindOfClass:[CAMetalLayer class]])
+        {
+            CAMetalLayer *ml = (CAMetalLayer *)view.layer;
+            fprintf(stderr, "gptk: metal layer drawableSize=%s pixelFormat=%lu fbOnly=%d device=%p displaySync=%d maxDrawables=%lu\n",
+                    [NSStringFromSize(NSSizeFromCGSize(ml.drawableSize)) UTF8String], (unsigned long)ml.pixelFormat, ml.framebufferOnly,
+                    ml.device, ml.displaySyncEnabled, (unsigned long)ml.maximumDrawableCount);
+        }
+    });
+}
