+/*
+ * Compatibility table for Apple's Game Porting Toolkit D3DMetal layer.
+ *
+ * libd3dshared.dylib resolves a data symbol named "macdrv_functions" with
+ * dlsym(RTLD_DEFAULT) and expects a table of 24 function pointers matching
+ * the winemac.drv that ships with GPTK (a Wine 7.7 derivative). This file
+ * recreates that table on top of the Wine 11 winemac.drv internals so the
+ * D3DMetal swapchain can attach a CAMetalLayer to a Wine window.
+ *
+ * Only slots 0-9 are used by libd3dshared; the remaining win32 helper slots
+ * are left NULL.
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <pthread.h>
+#include <stdlib.h>
+
+#include "macdrv.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(gptk);
+
+/* Layout expected by libd3dshared: the client cocoa view is read at +0x18. */
+struct gptk_win_data
+{
+    HWND hwnd;
+    macdrv_window cocoa_window;
+    macdrv_view cocoa_view;
+    macdrv_view client_cocoa_view;
+    struct macdrv_win_data *data;
+};
+
+extern void OnMainThread(void *block);
+extern void macdrv_gptk_dump_metal_view(macdrv_metal_view v);
+
+static macdrv_metal_view gptk_view_create_metal_view(macdrv_view view, macdrv_metal_device device)
+{
+    macdrv_metal_view mv = macdrv_view_create_metal_view(view, device);
+    TRACE("view %p device %p -> metal view %p\n", view, device, mv);
+    macdrv_gptk_dump_metal_view(mv);
+    return mv;
+}
+
+/* Client views created for D3DMetal. The GDI surface flush in surface.c hides
+ * the window's client view so a stale swapchain view does not occlude GDI
+ * content; D3DMetal never re-presents through winemac, so its views must be
+ * exempt from that or the game renders into an invisible layer. */
+static macdrv_view gptk_views[16];
+static pthread_mutex_t gptk_views_lock = PTHREAD_MUTEX_INITIALIZER;
+
+static void gptk_track_view(macdrv_view view)
+{
+    unsigned int i;
+
+    pthread_mutex_lock(&gptk_views_lock);
+    for (i = 0; i < ARRAY_SIZE(gptk_views); i++)
+    {
+        if (gptk_views[i] == view) break;
+        if (!gptk_views[i])
+        {
+            gptk_views[i] = view;
+            break;
+        }
+    }
+    pthread_mutex_unlock(&gptk_views_lock);
+    if (i == ARRAY_SIZE(gptk_views)) WARN("too many D3DMetal client views, %p not tracked\n", view);
+}
+
+BOOL gptk_owns_client_view(macdrv_view view)
+{
+    unsigned int i;
+    BOOL owned = FALSE;
+
+    pthread_mutex_lock(&gptk_views_lock);
+    for (i = 0; i < ARRAY_SIZE(gptk_views) && gptk_views[i]; i++)
+        if (gptk_views[i] == view) owned = TRUE;
+    pthread_mutex_unlock(&gptk_views_lock);
+    return owned;
+}
+
+static void gptk_init(int flag)
+{
+    UINT paths = 0, modes = 0;
+
+    TRACE("flag %d\n", flag);
+    NtUserGetDisplayConfigBufferSizes(QDC_ONLY_ACTIVE_PATHS, &paths, &modes);
+}
+
+/* Make sure the window has a client view D3DMetal can render into. The
+ * surface reference is intentionally kept for the lifetime of the process:
+ * it must outlive every swapchain D3DMetal creates for the window. */
+static void gptk_ensure_client_view(HWND hwnd)
+{
+    struct macdrv_win_data *data;
+    struct client_surface *surface;
+    BOOL has_view;
+
+    if (!(data = get_win_data(hwnd))) return;
+    has_view = data->client_view != NULL;
+    release_win_data(data);
+    if (has_view) return;
+
+    surface = macdrv_CreateClientSurface(hwnd, 0, FALSE);
+    TRACE("created client surface %p for hwnd %p\n", surface, hwnd);
+}
+
+static void *gptk_get_win_data(HWND hwnd)
+{
+    struct macdrv_win_data *data;
+    struct gptk_win_data *w;
+
+    gptk_ensure_client_view(hwnd);
+
+    if (!(data = get_win_data(hwnd)))
+    {
+        WARN("no win data for hwnd %p\n", hwnd);
+        return NULL;
+    }
+    if (!(w = calloc(1, sizeof(*w))))
+    {
+        release_win_data(data);
+        return NULL;
+    }
+    gptk_track_view(data->client_view);
+    macdrv_set_view_hidden(data->client_view, FALSE);
+    w->hwnd = hwnd;
+    w->cocoa_window = data->cocoa_window;
+    w->cocoa_view = data->client_view;
+    w->client_cocoa_view = data->client_view;
+    w->data = data;
+    TRACE("hwnd %p window %p client view %p\n", hwnd, w->cocoa_window, w->client_cocoa_view);
+    return w;
+}
+
+static void gptk_release_win_data(struct gptk_win_data *w)
+{
+    if (!w) return;
+    release_win_data(w->data);
+    free(w);
+}
+
+DECLSPEC_EXPORT void *macdrv_functions[24] =
+{
+    gptk_init,                       /* 0 */
+    gptk_get_win_data,               /* 1 */
+    gptk_release_win_data,           /* 2 */
+    macdrv_get_cocoa_window,         /* 3 */
+    macdrv_create_metal_device,      /* 4 */
+    macdrv_release_metal_device,     /* 5 */
+    gptk_view_create_metal_view,     /* 6 */
+    macdrv_view_get_metal_layer,     /* 7 */
+    macdrv_view_release_metal_view,  /* 8 */
+    OnMainThread,                    /* 9 */
+    NULL, NULL, NULL, NULL, NULL, NULL, NULL,
+    NULL, NULL, NULL, NULL, NULL, NULL, NULL,
+};
