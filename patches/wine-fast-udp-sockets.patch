+/* Fast path for synchronous datagram I/O: try the syscall before asking wineserver. Every send and recv
+ * otherwise costs two server round trips, and a busy wineserver stalls the caller's network thread.
+ * Only used for UDP sockets called without APC, completion or forced async; anything but an immediate
+ * success falls back to the server path, which also resets the socket's event state.
+ * WINE_FAST_SOCKETS=0 disables it. */
+static BOOL sock_fast_path( int fd, PIO_APC_ROUTINE apc, void *apc_user )
+{
+    static int enabled = -1;
+    int type;
+    socklen_t len = sizeof(type);
+
+    if (enabled == -1)
+    {
+        const char *env = getenv( "WINE_FAST_SOCKETS" );
+        enabled = !env || atoi( env ) != 0;
+    }
+    if (!enabled || apc || apc_user || in_wow64_call()) return FALSE;
+    return !getsockopt( fd, SOL_SOCKET, SO_TYPE, &type, &len ) && type == SOCK_DGRAM;
+}
+
